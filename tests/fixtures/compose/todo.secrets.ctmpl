{{- /* Source: wangzitian0/infra2@4dd5ed29 platform/30.todo/secrets.ctmpl (verbatim after this line) */ -}}
{{- /* Generated from platform/todo by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/redis" $env) }}
REDIS_PASSWORD={{ printf "%q" .Data.data.password }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/todo" $env) }}
CANARY_POSTGRES_PASSWORD={{ printf "%q" .Data.data.CANARY_POSTGRES_PASSWORD }}
TODO_POSTGRES_PASSWORD={{ printf "%q" .Data.data.TODO_POSTGRES_PASSWORD }}
{{ with index .Data.data "S3_ACCESS_KEY" }}S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "S3_SECRET_KEY" }}S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "LLM_API_KEY" }}LLM_API_KEY={{ printf "%q" . }}{{ end }}
{{- end }}
