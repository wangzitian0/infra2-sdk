{
  "schema_version": 3,
  "service": "canary/todo",
  "required_env": [
    "APP_URL"
  ],
  "optional_env": [
    "TARGET_URL"
  ],
  "checks": [
    {
      "id": "smoke",
      "argv": [
        "sh",
        "-c",
        "script=canary/todo/worker.py; [ -f worker.py ] && script=worker.py; exec python3 \"$script\" --once --health-url \"${TARGET_URL:-$APP_URL}/readyz\""
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 60
    }
  ]
}
